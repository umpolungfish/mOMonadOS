import Imscribing.Millennium.UniverseRulesets
import Imscribing.Millennium.ClayCanonicalTuples
import Imscribing.Millennium.ClayCandidateTuples
import Imscribing.Millennium.Clay_WitnessedClosure
import Imscribing.Millennium.Clay_UnclosedResistance

/-!
# Clay_TransportedClosure — RH transported by join reaches closure; bare RH does not

`Clay_UnclosedResistance.rh_closes_nowhere` proves the canonical `riemann_hypothesis`
imscription reaches `idempotent_terminal` under none of the 23 gate-universes, and
names the shared cause: Ω (protection/winding) below the terminal anchor `ah` (3) —
RH sits at `oak` (2).

This module tests two **transported** types — RH joined with another catalog type
via the Grammar's `join` (LUB) operation, both already present in `IG_catalog.json`
and sourced here the same procedural way as the canonical six (`ClayCandidateTuples`,
generated by `scripts/gen_clay_canonical_tuples.py`'s glyph-inverse map, none
hand-written):

* **`rh_hc_join`** (RH ⊔ Hodge Conjecture): Ω promoted to `ah` (3). Reaches
  `idempotent_terminal` under 16 of the 23 universes, **and is `T_CEILING`-consistent**
  — the same two-part bar `bsd_witnessed_closure`/`hodge_witnessed_closure` clear.
* **`rh_ep_join`** (RH ⊔ an exceptional-point regime): Ω also promoted to `ah` (3).
  Reaches `idempotent_terminal` under 17 of the 23 (one more than the Hodge join:
  `kinetics_trap`), but is **not** `T_CEILING`-consistent — blocked on Ç (kinetics),
  the identical axis and identical shape as `Clay_WitnessedClosure.ym_blocker_is_kinetics`.

Both closing sets were found by exhaustive `#eval` profiling against
`Clay_UnclosedResistance.universes` (`ClayCandidateProfile.lean`, scratch) before
being asserted here as decided theorems.

## Honest scope (for the curmudgeon)

This is **not** a proof of the Riemann Hypothesis, and does **not** discharge the
`sorry` markers in `RH.lean`. `rh_hc_join`/`rh_ep_join` are distinct structural types
from bare `riemann_hypothesis` — the join of RH with another type, not RH alone. What
is proved: promoting the single axis (Ω) that `rh_ns_pnp_low_winding` names as RH's
shared blocker — via joining with an already-Ω≥3 type already in the catalog, not by
hand-editing RH's tuple — is *sufficient in the operad model* to cross from closing
under zero universes to closing under most of them. The finding is about where the
obstruction lives (one axis) and that it is removable by transport (join with a
higher-winding type), not a claim about the analytic conjecture.
-/

namespace Imscribing.Millennium.ClayTransportedClosure

open Imscribing.Primitives
open Millennium.UniverseRulesets
open Imscribing.Millennium.ClayWitnessedClosure (tCeilingConsistent)

abbrev rhHcJoin : Imscription := ClayCandidateTuples.rhHcJoin
abbrev rhEpJoin : Imscription := ClayCandidateTuples.rhEpJoin

/-- The 16 universes `rh_hc_join` reaches `idempotent_terminal` under
    (found by exhaustive profiling against the 23-universe list). -/
def rhHcJoinClosingUniverses : List Ruleset :=
  [ ruleset_canonical, ruleset_low_gate, ruleset_strict_frobenius, ruleset_inverted_gates,
    ruleset_no_ordering, ruleset_winding_first, ruleset_t_structural, ruleset_scope_universe,
    ruleset_dimensional_gate, ruleset_t_hybrid, ruleset_t_inverted, ruleset_single_gate,
    ruleset_fidelity_universe, ruleset_stoichiometry_universe, ruleset_absorption_scope_empire,
    ruleset_absorption_topology_seal ]

/-- The 17 universes `rh_ep_join` reaches `idempotent_terminal` under — the same 16
    as the Hodge join, plus `kinetics_trap`. -/
def rhEpJoinClosingUniverses : List Ruleset :=
  ruleset_kinetics_trap :: rhHcJoinClosingUniverses

-- ── rh_hc_join: gate closure across 16 universes AND T_CEILING-consistent ──

/-- RH ⊔ Hodge reaches `idempotent_terminal` under all 16 named universes,
    and is `T_CEILING`-consistent — the full bar BSD and Hodge each clear. -/
theorem rh_hc_join_witnessed_closure :
    rhHcJoinClosingUniverses.all (fun r => decide (r.operadLayer rhHcJoin = .idempotent_terminal))
      = true ∧
    tCeilingConsistent rhHcJoin = true := by
  native_decide

-- ── rh_ep_join: gate closure across 17 universes, but T_CEILING-blocked ──

/-- RH ⊔ exceptional-point reaches `idempotent_terminal` under all 17 named
    universes, but is **not** `T_CEILING`-consistent. -/
theorem rh_ep_join_gate_closure :
    rhEpJoinClosingUniverses.all (fun r => decide (r.operadLayer rhEpJoin = .idempotent_terminal))
      = true ∧
    tCeilingConsistent rhEpJoin = false := by
  native_decide

/-- The blocker is Ç (kinetics) — same axis, same ceiling, as `ym_blocker_is_kinetics`. -/
theorem rh_ep_join_blocker_is_kinetics :
    (ordinalK rhEpJoin.kin ≤ 3) = False ∧
    ordinalP rhEpJoin.pol ≤ 5 ∧ ordinalF rhEpJoin.fid ≤ 3 ∧
    ordinalH rhEpJoin.chir ≤ 4 ∧ ordinalOmega rhEpJoin.prot ≤ 3 := by
  native_decide

-- ── The contrast with bare RH (already proved in Clay_UnclosedResistance) ──

/-- Bare RH: zero universes. RH ⊔ Hodge: 16, plus `T_CEILING`. Same winding axis,
    same catalog, transported by join rather than by hand-edit. -/
theorem transport_raises_closure :
    (Imscribing.Millennium.ClayUnclosedResistance.universes.any
      (fun r => decide (r.operadLayer ClayUnclosedResistance.rh = .idempotent_terminal)) = false) ∧
    (rhHcJoinClosingUniverses.all
      (fun r => decide (r.operadLayer rhHcJoin = .idempotent_terminal)) = true) := by
  native_decide

end Imscribing.Millennium.ClayTransportedClosure
