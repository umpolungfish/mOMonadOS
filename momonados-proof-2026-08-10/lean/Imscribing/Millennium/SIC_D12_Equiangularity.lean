import Mathlib

/-!
# SIC_D12_Equiangularity — the 143 overlap identities, exact per-overlap (machine-checked)

Part of the d=12 axiom-drop build (target `crystal_forces_d12_sic`). This file
discharges the **equiangularity half** of `IsSICPOVM 12 ψ` at the pinned-data level:
for every Weyl–Heisenberg displacement (a,b) ≠ (0,0), the overlap
O_{a,b} = ⟨ψ|D_{a,b}|ψ⟩ satisfies |O_{a,b}|² = 1/13 = 1/(d+1).

**The dissolve (why no deg-512 tower is needed):** each overlap is individually a
LOW-degree algebraic number — the 143 degrees distribute as deg 2: 7, deg 4: 16, deg 8: 32, deg 16: 48, deg 32: 40 — even though the
twelve coordinates jointly live in a degree-512 magnitude tower over K16. So the
equiangularity condition splits into 143 small per-overlap identities.

**Data provenance (overlap_pin.gp, 1500-digit fiducial, floor gate > 4700 bits):**
for each (a,b) the pinned data is
 * `ptail` — the monic min poly of O_{a,b} (irreducible over ℚ, algdep deep-vanish
   floored), stored highest-first after the leading 1;
 * `q` — the coefficient vector (constant-first) with conj(O) = q(O) in the power
   basis {1, O, …, O^(n-1)}, recovered by lindep **independently** of p and
   re-verified numerically to the floor.

**What `equiangularity_all` checks, exactly:** 13·x·q(x) ≡ 1  (mod p)  in ℚ[x],
for all 143 entries. Given the two pinnings (O root of p, conj(O) = q(O)) this is
precisely 13·O·conj(O) = 13·|O_{a,b}|² = 1. Pure rational polynomial arithmetic,
no floats, no √ — the exact closure of the cont.12 floor certificate. Together with
`SIC_D12_Norm.norm_sum` (trace-one half) this machine-checks both defining SIC
conditions on the pinned d=12 fiducial data.
-/

namespace SIC.D12.Equiangularity

/-- Polynomial over ℚ as a coefficient list, constant term first. -/
abbrev Poly := List ℚ

/-- Polynomial addition (zero-padded). -/
def padd : Poly → Poly → Poly
  | xs, [] => xs
  | [], ys => ys
  | x :: xs, y :: ys => (x + y) :: padd xs ys

/-- Scalar multiple. -/
def pscale (c : ℚ) (xs : Poly) : Poly := xs.map (c * ·)

/-- Polynomial multiplication. -/
def pmul (xs ys : Poly) : Poly :=
  xs.foldr (fun a acc => padd (pscale a ys) ((0 : ℚ) :: acc)) []

/-- Subtract `ys` from the leading entries of `xs` (both aligned at the head). -/
def subHead : List ℚ → List ℚ → List ℚ
  | xs, [] => xs
  | [], _ => []
  | x :: xs, y :: ys => (x - y) :: subHead xs ys

/-- One reduction pass, highest-first: while deg ≥ n, kill the top coefficient
    against the monic divisor `1 :: ptail`. Fuel-bounded (fuel = initial length). -/
def reduceGo : ℕ → List ℚ → List ℚ → ℕ → List ℚ
  | 0, xs, _, _ => xs
  | fuel + 1, xs, ptail, n =>
    if xs.length ≤ n then xs
    else
      match xs with
      | [] => []
      | c :: rest => reduceGo fuel (subHead rest (pscale c ptail)) ptail n

/-- `xs mod (xⁿ + ptail)`: constant-first in, constant-first out. -/
def pmod (xs : Poly) (ptail : List ℚ) (n : ℕ) : Poly :=
  (reduceGo xs.length xs.reverse ptail n).reverse

/-- A pinned overlap: WH index (a,b), degree n, monic min-poly tail (highest-first),
    and conj(O) = q(O) in the power basis (constant-first). -/
structure Ovl where
  a : ℕ
  b : ℕ
  n : ℕ
  ptail : List ℚ
  q : Poly

/-- The exact equiangularity identity for one overlap:
    13·x·q(x) − 1 ≡ 0 (mod p), i.e. 13·O·conj(O) = 1, i.e. |O|² = 1/13. -/
def check (e : Ovl) : Bool :=
  e.ptail.length == e.n && e.q.length == e.n &&
  (pmod (padd (pmul [(0 : ℚ), 13] e.q) [(-1 : ℚ)]) e.ptail e.n).all (· == 0)

