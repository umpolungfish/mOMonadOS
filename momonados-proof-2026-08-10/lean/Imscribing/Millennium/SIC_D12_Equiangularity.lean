/-- **Equiangularity, exact.** All 143 pinned WH overlaps satisfy 13·|O_{a,b}|² = 1
    as an exact identity in ℚ(O_{a,b}). -/
theorem equiangularity_all : ovls.all check = true := by native_decide

/-- Exactly the 143 non-identity WH indices are covered, in order, no gaps. -/
theorem covers_all_pairs :
    ovls.map (fun e => (e.a, e.b)) =
      ((List.range 12).flatMap fun a => (List.range 12).map fun b => (a, b)).filter
        (fun ab => ab != (0, 0)) := by
  native_decide

end SIC.D12.Equiangularity
