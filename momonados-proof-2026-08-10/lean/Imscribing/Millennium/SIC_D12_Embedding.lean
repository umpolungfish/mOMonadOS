lemma g0C_pow16_add_redVec : (g0C : ℂ) ^ 16 + evalK16Hi g0C k16RedVec = 0 := by
  rw [evalK16Hi_redVec_val]
  have hp : k16Poly.eval g0 = 0 := g0_root
