/-! ## 0. K16 evaluation (Horner, constant-first) -/

def evalK16 (g : ℂ) : List ℚ → ℂ
  | [] => 0
  | x :: xs => (x : ℂ) + g * evalK16 g xs

@[simp] lemma evalK16_nil (g : ℂ) : evalK16 g [] = 0 := rfl

@[simp] lemma evalK16_cons (g : ℂ) (c : ℚ) (cs : List ℚ) :
    evalK16 g (c :: cs) = (c : ℂ) + g * evalK16 g cs := rfl

lemma evalK16_append (g : ℂ) (xs ys : List ℚ) :
    evalK16 g (xs ++ ys) = evalK16 g xs + g ^ xs.length * evalK16 g ys := by
  induction' xs with a as ih generalizing ys
  · simp [evalK16]
  · simp [evalK16_cons, ih, add_assoc, mul_add, add_mul]; ring

/-! ## 1. The K16 real root via IVT -/

def k16Poly : Polynomial ℝ :=
  Polynomial.monomial 16 (1 : ℝ) + Polynomial.monomial 14 (-10 : ℝ) +
  Polynomial.monomial 12 (40 : ℝ) + Polynomial.monomial 10 (-90 : ℝ) +
  Polynomial.monomial 8 (126 : ℝ) + Polynomial.monomial 6 (-96 : ℝ) +
  Polynomial.monomial 4 (25 : ℝ) + Polynomial.monomial 2 (2 : ℝ) +
  Polynomial.monomial 0 (1 : ℝ)

/-- Explicit polynomial form for numeric evaluation. -/
lemma k16_eval (x : ℝ) : k16Poly.eval x =
    x^16 - 10*x^14 + 40*x^12 - 90*x^10 + 126*x^8 - 96*x^6 + 25*x^4 + 2*x^2 + 1 := by
  simp only [k16Poly, Polynomial.eval_add, Polynomial.eval_monomial]; ring

/-- The SIC embedding root is the one near g0 = -2.00857305408968940053, NOT the
    (0,1) root. `k16Poly` is even (only even powers), so ±(each real root) both occur;
    the fiducial data (d12_sic_build) pins the *negative* branch, where all twelve
    moduli evaluate to positive reals summing to 1.

    The bracket is width 10⁻¹² — tight enough that the divided-difference positivity
    certificates below close with 4+ orders of slack (worst hw·L = 3.2e-5 on the c5
    discriminant against margin 8.06). Endpoint rationals, certificates, and margins
    generated + exact-Fraction re-verified by d12_sic_build/gen_lean_boundary.py;
    never hand-entered. Endpoint signs are checked in ℚ by native_decide and lifted
    (13-digit numerators to the 16th power are far beyond norm_num on ℝ). -/
def certLo : ℚ := -2008573054090/1000000000000
def certHi : ℚ := -2008573054089/1000000000000
def certMid : ℚ := -4017146108179/2000000000000
def certHw : ℚ := 1/2000000000000
def certB : ℚ := 201/100

/-- Rational form of k16Poly for exact endpoint sign checks. -/
lemma k16_eval_rat (q : ℚ) : k16Poly.eval ((q : ℚ) : ℝ) =
    ((q^16 - 10*q^14 + 40*q^12 - 90*q^10 + 126*q^8 - 96*q^6 + 25*q^4 + 2*q^2 + 1 : ℚ) : ℝ) := by
  rw [k16_eval]; push_cast; ring

theorem cert_k16_lo : (0:ℚ) < certLo^16 - 10*certLo^14 + 40*certLo^12 - 90*certLo^10
    + 126*certLo^8 - 96*certLo^6 + 25*certLo^4 + 2*certLo^2 + 1 := by native_decide

theorem cert_k16_hi : (certHi^16 - 10*certHi^14 + 40*certHi^12 - 90*certHi^10
    + 126*certHi^8 - 96*certHi^6 + 25*certHi^4 + 2*certHi^2 + 1 : ℚ) < 0 := by native_decide

lemma poly_at_lb : k16Poly.eval ((certLo : ℚ) : ℝ) > 0 := by
  rw [k16_eval_rat]; exact_mod_cast cert_k16_lo

lemma poly_at_ub : k16Poly.eval ((certHi : ℚ) : ℝ) < 0 := by
  rw [k16_eval_rat]; exact_mod_cast cert_k16_hi

lemma exists_root : ∃ g : ℝ, ((certLo:ℚ):ℝ) < g ∧ g < ((certHi:ℚ):ℝ) ∧ k16Poly.eval g = 0 := by
  have h0 : k16Poly.eval ((certLo:ℚ):ℝ) > 0 := poly_at_lb
  have h1 : k16Poly.eval ((certHi:ℚ):ℝ) < 0 := poly_at_ub
  have hab : ((certLo:ℚ):ℝ) ≤ ((certHi:ℚ):ℝ) := by
    have h : certLo ≤ certHi := by native_decide
    exact_mod_cast h
  have hc : ContinuousOn k16Poly.eval (Set.Icc ((certLo:ℚ):ℝ) ((certHi:ℚ):ℝ)) :=
    k16Poly.continuous.continuousOn
  have hs : Set.Icc (k16Poly.eval ((certHi:ℚ):ℝ)) (k16Poly.eval ((certLo:ℚ):ℝ)) ⊆
      k16Poly.eval '' Set.Icc ((certLo:ℚ):ℝ) ((certHi:ℚ):ℝ) := intermediate_value_Icc' hab hc
  have hm : (0 : ℝ) ∈
      Set.Icc (k16Poly.eval ((certHi:ℚ):ℝ)) (k16Poly.eval ((certLo:ℚ):ℝ)) := by
    rw [Set.mem_Icc]; constructor <;> linarith
  have him : (0 : ℝ) ∈ k16Poly.eval '' Set.Icc ((certLo:ℚ):ℝ) ((certHi:ℚ):ℝ) := hs hm
  rcases him with ⟨g, hg, hgv⟩
  have hgl : g ≠ ((certLo:ℚ):ℝ) := by rintro rfl; linarith
  have hgu : g ≠ ((certHi:ℚ):ℝ) := by rintro rfl; linarith
  obtain ⟨hge, hle⟩ := Set.mem_Icc.mp hg
  refine ⟨g, lt_of_le_of_ne hge (fun h => hgl h.symm),
    lt_of_le_of_ne hle hgu, hgv⟩

noncomputable def g0 : ℝ := Classical.choose exists_root
lemma g0_lb : ((certLo:ℚ):ℝ) < g0 := (Classical.choose_spec exists_root).1
lemma g0_ub : g0 < ((certHi:ℚ):ℝ) := (Classical.choose_spec exists_root).2.1
lemma g0_neg : g0 < 0 := by
  have h := g0_ub
  have h2 : certHi < 0 := by native_decide
  have h3 : ((certHi:ℚ):ℝ) < 0 := by exact_mod_cast h2
  linarith
lemma g0_root : k16Poly.eval g0 = 0 := (Classical.choose_spec exists_root).2.2

/-- g0 is within half-width of the bracket midpoint. -/
lemma g0_near_mid : |g0 - ((certMid : ℚ) : ℝ)| ≤ ((certHw : ℚ) : ℝ) := by
  have h1 : certLo = certMid - certHw := by native_decide
  have h2 : certHi = certMid + certHw := by native_decide
  have hlo := g0_lb; have hhi := g0_ub
  rw [h1] at hlo; rw [h2] at hhi
  push_cast at hlo hhi
  rw [abs_le]; constructor <;> linarith

/-- Global bound |g0| ≤ B for the coefficient-sum estimates. -/
lemma g0_abs_le : |g0| ≤ ((certB : ℚ) : ℝ) := by
  have h1 : -certB ≤ certLo := by native_decide
  have h2 : certHi ≤ certB := by native_decide
  have hlo := g0_lb; have hhi := g0_ub
  have h1' : ((-certB : ℚ) : ℝ) ≤ ((certLo:ℚ):ℝ) := by exact_mod_cast h1
  have h2' : ((certHi:ℚ):ℝ) ≤ ((certB:ℚ):ℝ) := by exact_mod_cast h2
  push_cast at h1'
  rw [abs_le]; constructor <;> linarith

