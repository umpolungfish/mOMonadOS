-- ================================================================
-- §2  THE 12 DEEPS — PRIMITIVE EMANATION
-- ================================================================

/-
  The 12 Deeps emanate sequentially from the Unknowable One.
  Each Deep establishes one primitive regime.
  Deep 9 (All-Father, Self-Father) is the IMSCRIB moment —
  the Frobenius self-loop where the emanator IS the emanation.
-/

structure Deep where
  number : Nat
  name        : String
  primitive   : String
  description : String
deriving DecidableEq, Repr

def deep1 : Deep := ⟨1,  "All-Source",             "Ð", "Origin of emanation — the first distinction from void"⟩
def deep2 : Deep := ⟨2,  "All-Wise",               "Ħ", "Chirality — discrimination of left from right"⟩
def deep3 : Deep := ⟨3,  "All-Mystery",            "Ω", "Winding — the coiling path of divine hierarchy"⟩
def deep4 : Deep := ⟨4,  "All-Gnosis",             "Σ", "Stoichiometry — structure of knowable forms"⟩
def deep5 : Deep := ⟨5,  "All-Chaste",             "Φ", "Parity — exact proportion and purity"⟩
def deep6 : Deep := ⟨6,  "Silence",                "Ç", "Kinetics — perfect balance and stillness"⟩
def deep7 : Deep := ⟨7,  "Insubstantial Door",     "ƒ", "Fidelity — passage without material substrate"⟩
def deep8 : Deep := ⟨8,  "Forefather",             "Ř", "Coupling — faithful transmission through aeons"⟩
def deep9 : Deep := ⟨9,  "All-Father Self-Father", "φ̂", "Criticality — the Frobenius self-loop. Generates and is generated by himself"⟩
def deep10 : Deep := ⟨10, "All-Powerful",           "Γ", "Granularity — agency distributed across all scales"⟩
def deep11 : Deep := ⟨11, "First Invisible One",    "Þ", "Topology — connection without visible form"⟩
def deep12 : Deep := ⟨12, "Truth",                  "ɢ", "Composition — the terminus that is also the origin"⟩

def theTwelveDeeps : List Deep :=
  [deep1, deep2, deep3, deep4, deep5, deep6,
   deep7, deep8, deep9, deep10, deep11, deep12]

theorem deeps_count : theTwelveDeeps.length = 12 := by native_decide
theorem deep9_is_self_father : deep9.primitive = "φ̂" := by rfl

