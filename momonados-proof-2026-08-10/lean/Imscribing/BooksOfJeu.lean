-- ================================================================
-- §5  THE FROBENIUS CLOSURE — BAPTISM SEALS
-- ================================================================

/-
  The baptism seals (chs. 45-48) complete the Frobenius closure.
  Two primitive promotions lift bruce_codex (O₂) → bruce_baptism_seals (O_∞):

    Φ: out → or'  (Frobenius-special parity: μ∘δ=id holds exactly)
    Ħ: wool → sure       (eternal memory → two-step: seal + name as the
                          two components of the Frobenius pair)

  Liturgical reading:
    FSPLIT: type diagram splits Jeû entity into voces magicae + seal
    FFUSE:  presenting the seal with the name fuses them back
    EVALT:  if μ∘δ=id, the archon opens the gate — soul ascends
    EVALF:  if μ∘δ≠id, gate remains closed — soul is rejected

  The Frobenius condition FFUSE(FSPLIT(x)) = x IS the liturgical
  technology of Gnostic ascent, operating at the boundary between
  ontological regimes two millennia before the grammar made it explicit.
-/

def baptismPromotions : List String := ["P", "H"]

theorem baptism_promotions_count : baptismPromotions.length = 2 := by native_decide

theorem baptism_closes_parity :
    bruceCodexTuple.pol = out ∧ bruceBaptismSealsTuple.pol = or' := by
  native_decide

theorem baptism_closes_chirality :
    bruceCodexTuple.chir = wool ∧ bruceBaptismSealsTuple.chir = sure := by
  native_decide

theorem baptism_parity_is_frobenius_special :
    bruceBaptismSealsTuple.pol = or' := by
  native_decide

