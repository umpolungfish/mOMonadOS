// Draw a braid word.
//
// `qc` and `jp` print braid words as runs of signed integers. That is the exact
// object and it is unreadable past a dozen crossings — a 385-generator word is
// a wall of digits in which nothing about the braid is visible. The word is a
// picture; this renders it as one, in two forms.
//
// The terminal form is a strand diagram, three rows per crossing, with the
// under-strand broken at the crossing so over and under are distinguishable
// rather than merely counted. The SVG form is the same diagram as a file: the
// permutation is tracked so each physical strand keeps its colour from top to
// bottom, which is what makes a long word legible at a glance.
//
// Both forms carry the crossing index in the gutter, because the reason to look
// at a 385-crossing braid is almost always to find one specific crossing in it.

use alloc::format;
use alloc::string::String;
use alloc::vec;
use alloc::vec::Vec;

/// Strands a word needs: sigma_k acts on k and k+1, so the largest generator
/// fixes the count. A word with no generators is still a braid — on the two
/// strands that would be its narrowest home.
pub fn strands_for(word: &[i32]) -> usize {
    let hi = word.iter().map(|g| g.unsigned_abs() as usize).max().unwrap_or(1);
    (hi + 1).max(2)
}

/// The permutation a braid word induces, as `perm[position] = original strand`.
/// Reading it top to bottom is reading which strand ends up where.
pub fn permutation(word: &[i32], strands: usize) -> Vec<usize> {
    let mut p: Vec<usize> = (0..strands).collect();
    for &g in word {
        let i = (g.unsigned_abs() as usize) - 1;
        if i + 1 < strands { p.swap(i, i + 1); }
    }
    p
}

/// A braid is pure when every strand returns to its own position.
pub fn is_pure(word: &[i32], strands: usize) -> bool {
    permutation(word, strands).iter().enumerate().all(|(i, &s)| i == s)
}

pub fn writhe(word: &[i32]) -> i32 { word.iter().map(|g| g.signum()).sum() }

/// Clamp a requested window to the word. Returns the half-open range actually
/// drawn, so the caller can say what it left out instead of quietly truncating.
pub fn window(len: usize, start: usize, count: usize) -> (usize, usize) {
    let s = start.min(len);
    let e = if count == 0 { len } else { (s + count).min(len) };
    (s, e)
}

// ── terminal form ──────────────────────────────────────────────────

/// Strand diagram, three text rows per crossing.
///
/// Strand k sits in column 2k. A crossing between k and k+1 replaces those two
/// columns for its three rows: the strands part, cross, and rejoin. The
/// over-strand's diagonal runs unbroken through the middle row; the under one
/// is absent there. That break is the whole content of the sign — without it a
/// crossing and its inverse draw identically.
pub fn ascii(word: &[i32], strands: usize, start: usize, end: usize) -> String {
    let w = if strands == 0 { 1 } else { 2 * strands - 1 };
    let mut out = String::new();

    out.push_str("      ");
    for k in 0..strands {
        out.push_str(&format!("{}", (k + 1) % 10));
        if k + 1 < strands { out.push(' '); }
    }
    out.push('\n');

    for idx in start..end {
        let g = word[idx];
        let i = (g.unsigned_abs() as usize) - 1;
        let (a, m, b) = (2 * i, 2 * i + 1, 2 * i + 2);

        for row in 0..3usize {
            let mut cells: Vec<char> = (0..w)
                .map(|c| if c % 2 == 0 { '│' } else { ' ' })
                .collect();
            if b < w {
                match row {
                    0 => { cells[a] = '╲'; cells[b] = '╱'; }
                    1 => {
                        cells[a] = ' ';
                        cells[b] = ' ';
                        // The strand that stays whole through the middle is the
                        // one on top: '╲' runs left-over-right, '╱' right-over-left.
                        cells[m] = if g > 0 { '╲' } else { '╱' };
                    }
                    _ => { cells[a] = '╱'; cells[b] = '╲'; }
                }
            }
            let body: String = cells.into_iter().collect();
            if row == 1 {
                out.push_str(&format!("{:>5} {}  σ{}{}\n",
                    idx, body, i + 1, if g > 0 { "" } else { "⁻¹" }));
            } else {
                out.push_str(&format!("      {}\n", body));
            }
        }
    }
    out
}

// ── SVG form ─────────────────────────────────────────────────────

const PALETTE: [&str; 8] = [
    "#c0392b", "#2471a3", "#1e8449", "#b7950b",
    "#7d3c98", "#117a65", "#ba4a00", "#34495e",
]

const DX: i32 = 44;   // strand spacing
const DY: i32 = 30;   // one crossing
const MARGIN: i32 = 34;
const LW: i32 = 3;    // strand width
const HALO: i32 = 9;  // over-strand halo: what cuts the gap in the under strand

fn xof(col: i32, k: usize) -> i32 { col + DX * k as i32 }

/// Horizontal advance from one folded column to the next: the strands, the
/// crossing-index gutter, and air between.
fn col_advance(strands: usize) -> i32 {
    DX * (strands.saturating_sub(1)) as i32 + 74
}
/// The braid as a standalone SVG document.
///
/// Over/under is drawn the way it is drawn on paper: the under strand is laid
/// down whole, then the over strand is stroked twice — once wide in the
/// background colour, once at width in its own. The wide pass erases the under
/// strand exactly where it passes beneath, so the gap follows the curve without
/// anyone having to split it.
///
/// Colour follows the strand, not the position: the permutation is carried
/// along so the line leaving the top at position 3 is the same colour wherever
/// it arrives at the bottom.
///
/// `fold` wraps the braid into columns of that many crossings, read left to
/// right. A compiled circuit runs to hundreds of generators, and one column of
/// those is a page thirty thousand pixels tall — an image in the sense that a
/// filing cabinet is a book. Folded, the same word is a figure. The strand
/// entering a column at position k is the one that left the previous column
/// there, and the labels at each column's head and foot say which. `fold` of 0
/// draws the single column.
pub fn svg(word: &[i32], strands: usize, start: usize, end: usize, fold: usize) -> String {
    let rows = end.saturating_sub(start);
    let per = if fold == 0 { rows.max(1) } else { fold };
    let cols = if rows == 0 { 1 } else { (rows + per - 1) / per };
    let adv = col_advance(strands);
    let width = MARGIN * 2 + adv * cols as i32 - (adv - DX * (strands.saturating_sub(1)) as i32) + 46;
    let height = MARGIN * 2 + DY * (per.min(rows.max(1)) as i32 + 2);
    let bg = "#ffffff";

    // Which strand sits in each position at the top of the drawn window. The
    // window may begin mid-word, so replay the prefix rather than assume identity.
    let mut perm: Vec<usize> = permutation(&word[..start], strands);

    let mut s = String::new();
    s.push_str(&format!(
        "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{}\" height=\"{}\" viewBox=\"0 0 {} {}\">\n",
        width, height, width, height));
    s.push_str(&format!(
        "<title>braid word, {} generators on {} strands</title>\n",
        word.len(), strands));
    s.push_str(&format!(
        "<desc>writhe {}, {} braid, crossings {} to {}{}</desc>\n",
        writhe(word),
        if is_pure(word, strands) { "pure" } else { "non-pure" },
        start, end,
        if cols > 1 { format!(", folded into {} columns of {}", cols, per) }
        else { String::new() }));
    s.push_str(&format!("<rect width=\"100%\" height=\"100%\" fill=\"{}\"/>\n", bg));
    s.push_str("<g stroke-linecap=\"round\" fill=\"none\">\n");

    for c in 0..cols {
        let x0 = MARGIN + adv * c as i32;
        let lo = start + c * per;
        let hi = (lo + per).min(end);
        let mut y = MARGIN;

        // Lead-in, labelled with the strand each line arrives as.
        for k in 0..strands {
            s.push_str(&format!(
                "<path d=\"M {} {} L {} {}\" stroke=\"{}\" stroke-width=\"{}\"/>\n",
                xof(x0, k), y, xof(x0, k), y + DY, PALETTE[perm[k] % 8], LW));
            s.push_str(&format!(
                "<text x=\"{}\" y=\"{}\" font-family=\"monospace\" font-size=\"11\" text-anchor=\"middle\" fill=\"#555\" stroke=\"none\">{}</text>\n",
                xof(x0, k), y - 8, perm[k] + 1));
        }
        y += DY;

        for idx in lo..hi {
            let g = word[idx];
            let i = (g.unsigned_abs() as usize) - 1;
            let (xa, xb) = (xof(x0, i), xof(x0, i + 1));
            let (y0, y1) = (y, y + DY);
            // The two legs of the crossing, as S-curves.
            let lr = format!("M {} {} C {} {} {} {} {} {}",
                             xa, y0, xa, y0 + DY / 2, xb, y1 - DY / 2, xb, y1);
            let rl = format!("M {} {} C {} {} {} {} {} {}",
                             xb, y0, xb, y0 + DY / 2, xa, y1 - DY / 2, xa, y1);
            let (under, over, cu, co) = if g > 0 {
                (rl, lr, PALETTE[perm[i + 1] % 8], PALETTE[perm[i] % 8])
            } else {
                (lr, rl, PALETTE[perm[i] % 8], PALETTE[perm[i + 1] % 8])
            };
            s.push_str(&format!("<path d=\"{}\" stroke=\"{}\" stroke-width=\"{}\"/>\n",
                                under, cu, LW));
            s.push_str(&format!(
                "<path d=\"{}\" stroke=\"{}\" stroke-width=\"{}\" stroke-linecap=\"butt\"/>\n",
                over, bg, HALO));
            s.push_str(&format!("<path d=\"{}\" stroke=\"{}\" stroke-width=\"{}\"/>\n",
                                over, co, LW));

            s.push_str(&format!(
                "<text x=\"{}\" y=\"{}\" font-family=\"monospace\" font-size=\"9\" fill=\"#999\" stroke=\"none\">{}{}</text>\n",
                xof(x0, strands.saturating_sub(1)) + 12, y0 + DY / 2 + 3,
                idx, if g > 0 { "" } else { "\u{2212}" }));

            perm.swap(i, i + 1);
            y = y1;
        }

        for k in 0..strands {
            s.push_str(&format!(
                "<path d=\"M {} {} L {} {}\" stroke=\"{}\" stroke-width=\"{}\"/>\n",
                xof(x0, k), y, xof(x0, k), y + DY, PALETTE[perm[k] % 8], LW));
            s.push_str(&format!(
                "<text x=\"{}\" y=\"{}\" font-family=\"monospace\" font-size=\"11\" text-anchor=\"middle\" fill=\"#555\" stroke=\"none\">{}</text>\n",
                xof(x0, k), y + DY + 14, perm[k] + 1));
        }
    }

    s.push_str("</g>\n");
    s.push_str("</svg>\n");
    s
/// Word summary, printed above either form.
pub fn header(word: &[i32], strands: usize, start: usize, end: usize) -> String {
    let mut s = format!(
        "  {} generators on {} strands, writhe {}, {} braid\n",
        word.len(), strands, writhe(word),
        if is_pure(word, strands) { "pure" } else { "non-pure" });
    let p = permutation(word, strands);
    s.push_str("  permutation:");
    for &v in &p { s.push_str(&format!(" {}", v + 1)); }
    s.push('\n');
    if start > 0 || end < word.len() {
        s.push_str(&format!("  drawing crossings {}..{} of {}\n", start, end, word.len()));
    }
    s
}

/// Render the closed braid (Markor closure) as a boustrophedon-loop diagram with curvy paths.
///
/// The boustrophedon pattern lays out crossings in horizontal lanes that alternate
/// direction (left-to-right, then right-to-left), creating a dense zig-zag layout.
/// This allows arbitrarily many crossings to be packed into a compact area without
/// the exponential radius growth of circular layouts.
///
/// Each strand keeps its color from the permutation cycle it belongs to. At each
/// crossing, the over-strand is drawn with a background halo that erases a gap in
/// the under-strand. The permutation perm[position] = original_strand is tracked
/// so colors follow strands through crossings.
///
/// When a lane reverses direction, the S-curve geometry of the crossing is mirrored
/// so that the braid topology remains correct regardless of drawing direction.
pub fn svg_loop(word: &[i32], strands: usize) -> String {
    // The permutation a braid word induces, as perm[position] = original strand.
    let p = permutation(word, strands);
    
    // Assign each strand to a cycle ID based on the permutation cycles.
    let mut cycle_ids = vec![0usize; strands];
    let mut visited = vec![false; strands];
    let mut num_cycles = 0usize;
    for start in 0..strands {
        if !visited[start] {
            let mut curr = start;
            while !visited[curr] {
                visited[curr] = true;
                cycle_ids[curr] = num_cycles;
                curr = p[curr];
            }
            num_cycles += 1;
        }
    }

    let m_crossings = word.len().max(1);
    let bg = "#ffffff";

    // Dynamic sizing for boustrophedon layout
    let dr = 24.0f64;            // vertical spacing between strands
    let crossing_dx = 56.0f64;    // horizontal spacing between crossings in a lane
    let lane_height = 42.0f64;   // vertical spacing between boustrophedon lanes
    let margin = 40.0f64;
    let lw = 3.0f64;
    let halo = 9.0f64;

    // Determine optimal crossings per lane based on total crossings.
    let target_aspect = 1.6f64;
    let per_lane = libm::ceil(libm::sqrt((m_crossings as f64) / target_aspect)) as usize;
    let per_lane = per_lane.max(1).min(m_crossings);
    let num_lanes = (m_crossings + per_lane - 1) / per_lane;
    let per_lane = (m_crossings + num_lanes - 1) / num_lanes;

    let lane_width = crossing_dx * (per_lane as f64);
    let width = margin * 2.0 + lane_width + 80.0;
    let height = margin * 2.0 + lane_height * (num_lanes as f64) + 36.0;

    // Generate crossing coordinates
    let mut crossing_layout: Vec<(f64, f64, bool, f64)> = Vec::new();
    for j in 0..m_crossings {
        let lane = j / per_lane;
        let pos_in_lane = j % per_lane;
        let y = margin + lane as f64 * lane_height + lane_height / 2.0;
        let reverse = lane % 2 == 1;
        let x = if !reverse {
            margin + 24.0 + (pos_in_lane as f64) * crossing_dx
        } else {
            margin + 24.0 + ((per_lane - 1 - pos_in_lane) as f64) * crossing_dx
        };
        // x_entry is the x-coordinate where the strand enters this crossing from the previous one
        let x_entry = if j > 0 {
            crossing_layout[j - 1].0
        } else {
            x // first crossing, entry is at its own position
        };
        crossing_layout.push((x, y, reverse, x_entry));
    }

    let mut s = String::new();
    s.push_str(&format!(
        "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{:.0}\" height=\"{:.0}\" viewBox=\"0 0 {:.0} {:.0}\">\n",
        width, height, width, height));
    s.push_str(&format!(
        "<title>closed braid (boustrophedon), {} generators on {} strands</title>\n",
        word.len(), strands));
    s.push_str(&format!(
        "<rect width=\"100%\" height=\"100%\" fill=\"{}\"></rect>\n", bg));
    s.push_str("<g stroke-linecap=\"round\" fill=\"none\">\n");

    // Strand y-position helper: center the strands vertically around the crossing y
    let strand_y = |k: usize| -> f64 {
        (k as f64 - (strands as f64 - 1.0) / 2.0) * dr
    };

    // Track strand positions through crossings.
    // perm[position] = original_strand_id
    let mut perm: Vec<usize> = (0..strands).collect();

    // Draw inter-lane transition paths: connect end of one lane to start of next
    for lane in 0..num_lanes - 1 {
        let last_j = (lane + 1) * per_lane - 1;
        let next_j = (lane + 1) * per_lane;
        if next_j >= m_crossings { break; }
        
        let (last_x, last_y, last_rev, _) = crossing_layout[last_j];
        let (next_x, next_y, next_rev, _) = crossing_layout[next_j];
        
        // Draw transition connectors for each strand
        for k in 0..strands {
            let y_start = last_y + strand_y(k);
            let y_end = next_y + strand_y(k);
            
            // Connect with a smooth curve going down between lanes
            let mid_y = (y_start + y_end) / 2.0;
            let ctrl1_y = y_start + (mid_y - y_start) * 0.4;
            let ctrl2_y = y_end - (y_end - mid_y) * 0.4;
            let mid_x = (last_x + next_x) / 2.0;
            
            s.push_str(&format!(
                "<path d=\"M {:.2} {:.2} C {:.2} {:.2} {:.2} {:.2} {:.2} {:.2}\" \
                stroke=\"{}\" stroke-width=\"{}\" fill=\"none\"></path>\n",
                last_x + if last_rev { -14.0 } else { 14.0 }, y_start,
                mid_x, ctrl1_y,
                mid_x, ctrl2_y,
                next_x + if next_rev { 14.0 } else { -14.0 }, y_end,
                PALETTE[cycle_ids[perm[k]] % 8], lw));
        }
    }

    // Draw each crossing
    for j in 0..m_crossings {
        let (x, y, reverse, x_entry) = crossing_layout[j];
        let g = word[j];
        let i = (g.abs() as usize) - 1;
        if i + 1 >= strands { continue; }

        // Draw non-crossing strands as path segments connecting to previous crossing
        for k in 0..strands {
            if k == i || k == i + 1 { continue; }
            let yk = y + strand_y(k);
            // Determine entry x from previous crossing or start
            let entry_x = if j > 0 {
                let (prev_x, _, prev_rev, _) = crossing_layout[j - 1];
                prev_x + if prev_rev { -14.0 } else { 14.0 }
            } else {
                x
            };
            s.push_str(&format!(
                "<path d=\"M {:.2} {:.2} C {:.2} {:.2} {:.2} {:.2} {:.2} {:.2}\" \
                stroke=\"{}\" stroke-width=\"{}\"></path>\n",
                entry_x, yk,
                entry_x + (x - entry_x) * 0.3, yk,
                x - (x - entry_x) * 0.3, yk,
                if reverse { x - 14.0 } else { x + 14.0 }, yk,
                PALETTE[cycle_ids[perm[k]] % 8], lw));
        }

        let y_i = y + strand_y(i);
        let y_ip = y + strand_y(i + 1);

        // The S-curve geometry for the two crossing strands.
        let x_left = x - crossing_dx / 4.0;
        let x_right = x + crossing_dx / 4.0;
        let ctrl_near = crossing_dx / 8.0;
        let ctrl_far = crossing_dx / 8.0;

        // For a left-to-right lane: strand i enters from left (lower or upper),
        // strand i+1 enters from right.
        let (xl, xr) = if reverse { (x_right, x_left) } else { (x_left, x_right) };

        // path_i: strand i goes from (xl, y_i) curving to (xr, y_ip)
        let ctrl1_x = if reverse { xl - ctrl_near } else { xl + ctrl_near };
        let ctrl2_x = if reverse { xr - ctrl_far } else { xr + ctrl_far };

        let path_i = format!(
            "M {:.2} {:.2} C {:.2} {:.2} {:.2} {:.2} {:.2} {:.2}",
            xl, y_i,
            ctrl1_x, y_i,
            ctrl2_x, y_ip,
            xr, y_ip);

        let ctrl3_x = if reverse { xr + ctrl_near } else { xr - ctrl_near };
        let ctrl4_x = if reverse { xl + ctrl_far } else { xl - ctrl_far };

        let path_ip = format!(
            "M {:.2} {:.2} C {:.2} {:.2} {:.2} {:.2} {:.2} {:.2}",
            xr, y_ip,
            ctrl3_x, y_ip,
            ctrl4_x, y_i,
            xl, y_i);

        // Determine which is over and which is under based on crossing sign
        let (under, over, cu, co) = if g > 0 {
            (path_ip, path_i,
             PALETTE[cycle_ids[perm[i + 1]] % 8],
             PALETTE[cycle_ids[perm[i]] % 8])
        } else {
            (path_i, path_ip,
             PALETTE[cycle_ids[perm[i]] % 8],
             PALETTE[cycle_ids[perm[i + 1]] % 8])
        };

        // Draw under-strand first
        s.push_str(&format!(
            "<path d=\"{}\" stroke=\"{}\" stroke-width=\"{}\"></path>\n", under, cu, lw));
        // Draw over-strand with halo
        s.push_str(&format!(
            "<path d=\"{}\" stroke=\"{}\" stroke-width=\"{}\" stroke-linecap=\"butt\"></path>\n",
            over, bg, halo));
        s.push_str(&format!(
            "<path d=\"{}\" stroke=\"{}\" stroke-width=\"{}\"></path>\n", over, co, lw));

        // Crossing index label
        s.push_str(&format!(
            "<text x=\"{:.2}\" y=\"{:.2}\" font-family=\"monospace\" font-size=\"9\" \
            fill=\"#999\" stroke=\"none\">{}</text>\n",
            x + 12.0, y - 2.0, j));

        perm.swap(i, i + 1);
    }

    // Draw the Markov closure: connect end of last crossing in each lane back
    // to start of first crossing, going around the outside
    let last_j = m_crossings - 1;
    let first_j = 0;
    let (last_x, last_y, last_rev, _) = crossing_layout[last_j];
    let (first_x, first_y, first_rev, _) = crossing_layout[first_j];

    // Closure loop goes around the right side (or left side depending on layout)
    let loop_center_x = width - 20.0;
    let loop_center_y = height / 2.0;

    for k in 0..strands {
        // After all crossings, perm tells us which original strand is at each position.
        // For the closure, we connect strand at position k (end) back to strand k (start).
        let y_start = last_y + strand_y(k);
        let y_end = first_y + strand_y(k);

        let color = PALETTE[cycle_ids[k] % 8];

        // Draw a smooth S-curve closure path going around the outside
        let ctrl1_x = last_x + if last_rev { -32.0 } else { 32.0 };
        let ctrl2_x = first_x + if first_rev { 32.0 } else { -32.0 };
        let ctrl1_y = y_start;
        let ctrl2_y = y_end;

        s.push_str(&format!(
            "<path d=\"M {:.2} {:.2} C {:.2} {:.2} {:.2} {:.2} {:.2} {:.2}\" \
            stroke=\"{}\" stroke-width=\"{}\" fill=\"none\" stroke-dasharray=\"6,4\"></path>\n",
            last_x + if last_rev { -14.0 } else { 14.0 }, y_start,
            ctrl1_x, ctrl1_y,
            ctrl2_x, ctrl2_y,
            first_x + if first_rev { 14.0 } else { -14.0 }, y_end,
            color, lw));
    }

    // Draw entry point markers at the start of the first crossing
    for k in 0..strands {
        let (x, y, _, _) = crossing_layout[0];
        let yk = y + strand_y(k);
        s.push_str(&format!(
            "<circle cx=\"{:.2}\" cy=\"{:.2}\" r=\"3\" fill=\"{}\" \
            stroke=\"#333\" stroke-width=\"1\"></circle>\n",
            x + if crossing_layout[0].2 { 20.0 } else { -20.0 }, yk,
            PALETTE[cycle_ids[k] % 8]));
    }

    s.push_str("</g>\n");
    s.push_str("</svg>\n");
    s
}